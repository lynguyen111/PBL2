{
  "configurations": [
    {
      "name": "macOS",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/build/pbl2_book_autogen/include",
        "${workspaceFolder}/header",
        "${workspaceFolder}/header/service",
        "${workspaceFolder}/ui",
        "/opt/homebrew/lib/QtWidgets.framework/Headers",
        "/opt/homebrew/lib/QtCore.framework/Headers",
        "/opt/homebrew/lib/QtGui.framework/Headers",
        "/opt/homebrew/lib/QtCharts.framework/Headers",
        "/opt/homebrew/lib/QtOpenGL.framework/Headers",
        "/opt/homebrew/lib/QtOpenGLWidgets.framework/Headers",
        "/opt/homebrew/share/qt/mkspecs/macx-clang",
        "/opt/homebrew/include"
      ],
      "compilerPath": "/usr/bin/clang++",
      "cStandard": "c11",
      "cppStandard": "c++20",
      "intelliSenseMode": "macos-clang-arm64",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json"
    }
  ],
  "version": 4
}
